[resource]
script = ExtResource("1_qh8r5")
id = "B2OL1"
text_array = Array[String](["Wake up Sam! I’m heading to work early but I expect you to be on time today. You know you use the W, A, S, and D keys to move, soI don’t want to hear any excuses about ‘forgetting how to move’, again. Oh, and I’ve left some pocket money in front of the front door for you, you can pick it up using the E key, the same key you use to skip passed all the dialogue you can’t be bothered readi-"])
