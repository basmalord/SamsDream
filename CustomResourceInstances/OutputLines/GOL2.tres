script = ExtResource("1_l81is")
id = "GOL2"
text_array = Array[String](["Bah! Not nearly enough. Remember, if you want to go back, you have to pay the tithe. Those that can’t pay, can’t go back. Come back, to go back, when you have more bloodied coins."])
