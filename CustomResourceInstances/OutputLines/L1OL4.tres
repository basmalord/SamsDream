input_lines_id_array = Array[String](["L1L4-1"])
text_array = Array[String](["That’s the spirit! Now, I need you to go to Jen around the corner and ask her to put one up in the gallery, and then to Margo at the supplies shop down the road. Lastly, head back to the wharf and see if your dad will put some up in the shop for us!"])
